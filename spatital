####细胞通讯
library(CellChat)

cellchat_list <- list()

##做六个细胞通讯  实验"GSM7058757_C2"

for (sample_name in names(spa_list)) {
  ## 将annotation加到原表格中
  spa_list[[sample_name]]@meta.data$cellname <- paste(spa_list[[sample_name]]@meta.data$orig.ident,rownames(spa_list[[sample_name]]@meta.data),sep = "_")
  result <- inner_join(spa_list[[sample_name]]@meta.data, 
                       annotation_info, 
                       by = "cellname")
  spa_list[[sample_name]]@meta.data$annotation <- result$annotation
  Idents(spa_list[[sample_name]]) <- "annotation"
  
  # 1. 准备该样本的数据
  obj <- spa_list[[sample_name]]
  meta <- obj@meta.data
  meta <- (data.frame(labels = Idents(obj)))
  # 假设您已将聚类信息存储在 meta$labels 列中
  spatial.locs <- GetTissueCoordinates(obj,cols = c("imagerow", "imagecol")) # 获取该样本坐标
  spatial.locs$cell <- NULL
  #names(spatial.locs) <- c("imagerow","imagecol")
  
  DefaultAssay(obj) <- "Spatial"
  obj <- NormalizeData(obj)
  data.input <- GetAssayData(obj, slot = "data", assay = "Spatial")
  spatial_info <- obj@images[[sample_name]]
  spatial.factors <- spatial_info@scale.factors
  spatial.factors[["spot.diameter"]] <-  spatial.factors[["spot"]]
  # 2. 创建该样本的 CellChat 对象
  cellchat <- createCellChat(object = data.input,
                             meta = meta,
                             group.by = "labels",
                             datatype = "spatial",
                             coordinates = spatial.locs,
                             scale.factors = spatial.factors)
  
  CellChatDB <- CellChatDB.human
  CellChatDB.use <- subsetDB(CellChatDB, 
                             search = "Secreted Signaling", 
                             key = "annotation")
  cellchat@DB <- CellChatDB.use
  cellchat <- subsetData(cellchat)
  # 3. 进行该样本的CellChat标准分析（识别过表达配受体、推断通讯概率等）
  cellchat <- identifyOverExpressedGenes(cellchat)
  cellchat <- identifyOverExpressedInteractions(cellchat)
  
  coords <- cellchat@images$coordinates
  coords_matrix <- as.matrix(coords)
  colnames(coords_matrix) <- c("imagecol", "imagerow")
  cellchat@images$coordinates <- coords_matrix
  cellchat <- computeCommunProb(cellchat, type = "truncatedMean", trim = 0.1, distance.use = TRUE,scale.distance = 0.01)
  
  cellchat <- filterCommunication(cellchat, min.cells = 10)
  cellchat <- computeCommunProbPathway(cellchat)
  cellchat <- aggregateNet(cellchat)
  
  # 4. 存入列表
  cellchat_list[[sample_name]] <- cellchat
}



