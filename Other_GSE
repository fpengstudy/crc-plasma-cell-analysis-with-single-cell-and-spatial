##尝试其他GEO中是否也有TFF3细胞

library(Seurat)
library(harmony)

##  read file ##
####  GSE225857 ####

samples = list.files("~/raw_data/GSE225857_RAW")
sceList = lapply(samples,function(pro){
  folder=file.path("~/raw_data/GSE225857_RAW",pro)
  CreateSeuratObject(counts = Read10X(folder),
                     project = pro,
                     min.cells = 3, min.features = 200)
})

library(DoubletFinder)
for (i in 1:6) {
  sceList[[i]][["percent.mt"]] <- PercentageFeatureSet(sceList[[i]], pattern = "^MT-")
  #sceList[[i]][["percent.rb"]] <- PercentageFeatureSet(sceList[[i]], pattern = "^RP[SL]")
  sceList[[i]] <- subset(sceList[[i]], subset =  nFeature_RNA > 200 & nFeature_RNA < 7500 & percent.mt < 10 & nCount_RNA < 100000 )
  sceList[[i]] <- NormalizeData(sceList[[i]], normalization.method = "LogNormalize", scale.factor = 10000)
  sceList[[i]] <- FindVariableFeatures(sceList[[i]], selection.method = "vst", nfeatures = 2000)
  sceList[[i]] <- ScaleData(sceList[[i]])
  sceList[[i]] <- RunPCA(sceList[[i]])
  sceList[[i]] <- FindNeighbors(sceList[[i]], dims = 1:20)
  sceList[[i]] <- FindClusters(sceList[[i]], resolution = 0.5)
  sceList[[i]] <- RunUMAP(sceList[[i]],dims = 1:20)
  
  sweep.res.list <- paramSweep(sceList[[i]], PCs = 1:10, sct = FALSE)
  #使用log标准化，sct参数设置为 sct = F（默认 ）,如使用SCT标准化方法，设置为T
  for(j in 1:length(sweep.res.list)){
    if(length(sweep.res.list[[j]]$pANN[is.nan(sweep.res.list[[j]]$pANN)]) != 0){
      if(j != 1){
        sweep.res.list[[j]] <- sweep.res.list[[j - 1]]
      }else{
        sweep.res.list[[j]] <- sweep.res.list[[j + 1]]
      }
    }
  }
  sweep.stats <- summarizeSweep(sweep.res.list, GT = FALSE)
  bcmvn <- find.pK(sweep.stats)
  #可以看到最佳参数的点
  pk_v <- as.numeric(as.character(bcmvn$pK))
  pk_good <- pk_v[bcmvn$BCmetric==max(bcmvn$BCmetric)]
  DoubletRate = 0.075
  #10000细胞对应的doublets rate是～7.6%
  homotypic.prop <- modelHomotypic(sceList[[i]]$seurat_clusters) #最好提供celltype，而不是seurat_clusters。
  nExp_poi <- round(DoubletRate*ncol(sceList[[i]]))
  nExp_poi.adj <- round(nExp_poi*(1-homotypic.prop))
  #nExp_poi <- round(length(colnames(sceList[[i]]))*8*1e-6*length(colnames(sceList[[i]])))
  sceList[[i]] <- doubletFinder(sceList[[i]], PCs = 1:10, pN = 0.25, pK = pk_good, nExp = nExp_poi.adj, reuse.pANN = FALSE, sct = FALSE)
  
}

for (i in 1:6) {
  colnames(sceList[[i]]@meta.data)[7]<- "pANN"
  colnames(sceList[[i]]@meta.data)[8]<- "DF_classifications"
}

sce.big1 <- merge(sceList[[1]],
                 y = c(sceList[[2]],
                       sceList[[3]],
                       sceList[[4]],
                       sceList[[5]],
                       sceList[[6]]),
                 add.cell.ids = samples,
                 project = "CRC_GSE225857")

## 预处理
sce.big1 <- subset(sce.big1,DF_classifications=="Singlet")
sce.big1 <- NormalizeData(sce.big1, normalization.method = "LogNormalize", scale.factor = 1e4) 
sce.big1 <- FindVariableFeatures(sce.big1, selection.method = 'vst', nfeatures = 2000)
##缩放
all.genes <- rownames(sce.big1)
sce.big1 <- ScaleData(sce.big1,verbose = FALSE)
##PCA降维
sce.big1 <- RunPCA(sce.big1, features = VariableFeatures(object = sce.big1))


##批次效应
sce.big1 <-  RunHarmony(sce.big1, "orig.ident",
                       plot_convergence = F,dims.use = 1:20) 
sce.big1 <- FindNeighbors(sce.big1, dims = 1:20,reduction = 'harmony')
sce.big1 <- FindClusters(sce.big1, resolution = 0.5)
##resolution-0.5:20   resolution-0.8:22
#clustree(sce.big@meta.data, prefix = "RNA_snn_res.")  ## 查看分群分辨率
#sce.big <- RunTSNE(object = sce.big, dims = 1:20, reduction = 'harmony', do.fast = TRUE)
sce.big1 <- RunUMAP(object = sce.big1, dims = 1:20, reduction = 'harmony', do.fast = TRUE)
DimPlot(sce.big1,reduction = "umap",label=T,raster = FALSE)


##查看B细胞群
DotPlot(sce.big1,features = c("MS4A1","CD79A","CD19","JCHAIN","MZB1"))
##确定第4分群为B/P细胞
bcell1 <- subset(sce.big1,seurat_clusters=="4")
