##resolution-0.5:20   resolution-0.8:22
#clustree(sce.big@meta.data, prefix = "RNA_snn_res.")  ## 查看分群分辨率
#sce.big <- RunTSNE(object = sce.big, dims = 1:20, reduction = 'harmony', do.fast = TRUE)
bcell1 <- RunUMAP(object = bcell1, dims = 1:20, reduction = 'harmony', do.fast = TRUE)
DimPlot(bcell1,reduction = "umap",label=T,raster = FALSE)







