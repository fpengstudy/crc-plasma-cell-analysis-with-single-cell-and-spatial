##配对分析

paired_test <- function(dat, cell_name) {
  
  tmp <- dat %>%
    filter(celltype == cell_name) %>%
    select(patient, tissue, proportion) %>%
    pivot_wider(
      names_from = tissue,
      values_from = proportion
    ) %>%
    drop_na(`primary tumor`, `liver metastasis`)
  
  test <- wilcox.test(
    tmp$`primary tumor`,
    tmp$`liver metastasis`,
    paired = TRUE,
    exact = TRUE,
    correct = FALSE
  )
  
  data.frame(
    Cell = cell_name,
    N = nrow(tmp),
    Primary_median = median(tmp$`primary tumor`),
    Metastasis_median = median(tmp$`liver metastasis`),
    Median_difference = median(
      tmp$`liver metastasis` - tmp$`primary tumor`
    ),
    P_value = test$p.value
  )
}

