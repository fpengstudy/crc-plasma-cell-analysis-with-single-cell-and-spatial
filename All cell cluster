# 逐一分析每种细胞类型
celltypes <- unique(as.character(meta_patient$annotation))

for (ct in celltypes) {
  message("Analyzing cell type: ", ct)
  # 该细胞类型中符合过滤标准的患者-组织组合
  groups_ct <- eligible %>%
    filter(annotation == ct)
  
  if (nrow(groups_ct) == 0) next
  
  # 选择对应细胞
  cells_ct <- rownames(meta_patient)[
    meta_patient$annotation == ct &
      meta_patient$pb_id %in% groups_ct$pb_id
  ]
  
  if (length(cells_ct) == 0) next
  
  # 按患者-组织组合建立聚合矩阵
  group_factor <- factor(
    meta_patient[cells_ct, "pb_id"],
    levels = groups_ct$pb_id
  )
  
  aggregation_matrix <- sparse.model.matrix(
    ~ 0 + group_factor
  )
  
  rownames(aggregation_matrix) <- cells_ct
  
  pb_counts <- counts_all[
    ,
    cells_ct,
    drop = FALSE
  ] %*% aggregation_matrix
  
  colnames(pb_counts) <- groups_ct$pb_id
  
  # 建立 pseudobulk 元数据
  pb_meta <- groups_ct %>%
    select(
      pb_id,
      sample_patient,
      sample_orig,
      n_cells
    ) %>%
    distinct()
  
  pb_meta <- pb_meta[
    match(colnames(pb_counts), pb_meta$pb_id),
    ,
    drop = FALSE
  ]
  
  # 检查是否有重复的患者-组织组合
  stopifnot(!anyDuplicated(
    pb_meta[, c("sample_patient", "sample_orig")]
  ))
  
  # 仅保留两种组织都达到过滤标准的患者
  tab <- table(
    pb_meta$sample_patient,
    factor(
      pb_meta$sample_orig,
      levels = c(
        "primary tumor",
        "liver metastasis"
      )
    )
  )
  
  paired_ids <- rownames(tab)[
    tab[, "primary tumor"] > 0 &
      tab[, "liver metastasis"] > 0
  ]
  
  if (length(paired_ids) < 3) {
    message(
      "Skipping ", ct,
      ": fewer than 3 eligible paired patients."
    )
    next
  }
  
  keep_pb <- pb_meta$sample_patient %in% paired_ids
  
  pb_counts <- pb_counts[, keep_pb, drop = FALSE]
  pb_meta <- droplevels(
    pb_meta[keep_pb, , drop = FALSE]
  )
  
  # 检查每名患者是否恰好有两种组织
  pair_tab <- table(
    pb_meta$sample_patient,
    factor(
      pb_meta$sample_orig,
      levels = c(
        "primary tumor",
        "liver metastasis"
      )
    )
  )
  
  if (!all(pair_tab == 1)) {
    stop(
      "存在不完整或重复的配对记录：",
      ct
    )
  }
  
  # 设置参考组
  pb_meta$sample_orig <- factor(
    pb_meta$sample_orig,
    levels = c(
      "primary tumor",
      "liver metastasis"
    )
  )
  
  pb_meta$sample_patient <- factor(
    pb_meta$sample_patient
  )
  
  # 配对模型
  design <- model.matrix(
    ~ sample_patient + sample_orig,
    data = pb_meta
  )
  
  if (qr(design)$rank < ncol(design)) {
    message(
      "Skipping ", ct,
      ": design matrix is not full rank."
    )
    next
  }
  
  # edgeR 分析
  y <- DGEList(
    counts = as.matrix(pb_counts)
  )
  
  keep_genes <- filterByExpr(
    y,
    design = design
  )
  
  y <- y[
    keep_genes,
    ,
    keep.lib.sizes = FALSE
  ]
  
  if (nrow(y) == 0) next
  
  y <- calcNormFactors(y)
  
  y <- estimateDisp(
    y,
    design
  )
  
  fit <- glmQLFit(
    y,
    design,
    robust = TRUE
  )
  
  
  qlf <- edgeR::glmQLFTest(
    fit,
    coef = match("sample_origliver metastasis", colnames(design))
  )
  
  res <- topTags(
    qlf,
    n = Inf,
    adjust.method = "BH"
  )$table
  
  res$gene <- rownames(res)
  res$celltype <- ct
  res$n_paired_patients <- length(paired_ids)
  
  de_list[[ct]] <- res
}
  
