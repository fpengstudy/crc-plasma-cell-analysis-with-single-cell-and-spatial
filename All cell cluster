library(DoubletFinder)

for (i in 2:39) {
  sceList[[i]][["percent.mt"]] <- PercentageFeatureSet(sceList[[i]], pattern = "^MT-")
  #sceList[[i]][["percent.rb"]] <- PercentageFeatureSet(sceList[[i]], pattern = "^RP[SL]")
  sceList[[i]] <- subset(sceList[[i]], subset =  nFeature_RNA > 200 & nFeature_RNA < 7500 & percent.mt < 10 & nCount_RNA < 100000 )
  sceList[[i]] <- NormalizeData(sceList[[i]], normalization.method = "LogNormalize", scale.factor = 10000)
  sceList[[i]] <- FindVariableFeatures(sceList[[i]], selection.method = "vst", nfeatures = 2000)
  sceList[[i]] <- ScaleData(sceList[[i]])
  sceList[[i]] <- RunPCA(sceList[[i]])
  sceList[[i]] <- FindNeighbors(sceList[[i]], dims = 1:20)
  sceList[[i]] <- FindClusters(sceList[[i]], resolution = 0.5)
  sceList[[i]] <- RunUMAP(sceList[[i]],dims = 1:20)
  
  sweep.res.list <- paramSweep(sceList[[i]], PCs = 1:10, sct = FALSE)
  #使用log标准化，sct参数设置为 sct = F（默认 ）,如使用SCT标准化方法，设置为T
  for(j in 1:length(sweep.res.list)){
    if(length(sweep.res.list[[j]]$pANN[is.nan(sweep.res.list[[j]]$pANN)]) != 0){
      if(j != 1){
        sweep.res.list[[j]] <- sweep.res.list[[j - 1]]
      }else{
        sweep.res.list[[j]] <- sweep.res.list[[j + 1]]
      }
    }
  }
  sweep.stats <- summarizeSweep(sweep.res.list, GT = FALSE)
  bcmvn <- find.pK(sweep.stats)
  #可以看到最佳参数的点
  pk_v <- as.numeric(as.character(bcmvn$pK))
  pk_good <- pk_v[bcmvn$BCmetric==max(bcmvn$BCmetric)]
  DoubletRate = 0.075
  #10000细胞对应的doublets rate是～7.6%
  homotypic.prop <- modelHomotypic(sceList[[i]]$seurat_clusters) #最好提供celltype，而不是seurat_clusters。
  nExp_poi <- round(DoubletRate*ncol(sceList[[i]]))
  nExp_poi.adj <- round(nExp_poi*(1-homotypic.prop))
  #nExp_poi <- round(length(colnames(sceList[[i]]))*8*1e-6*length(colnames(sceList[[i]])))
  sceList[[i]] <- doubletFinder(sceList[[i]], PCs = 1:10, pN = 0.25, pK = pk_good, nExp = nExp_poi.adj, reuse.pANN = FALSE, sct = FALSE)
  
}




