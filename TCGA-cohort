nme2_list <- lapply(seq_len(nrow(sample_primary)), function(i) {
  
  f <- file.path(
    data_dir,
    sample_primary$File.Name[i]
  )
  
  if (!file.exists(f)) {
    warning("File not found: ", f)
    return(NULL)
  }
  
  dat <- fread(f)
  
  if (!all(c("gene_name", "tpm_unstranded") %in% names(dat))) {
    warning("Required columns missing: ", f)
    return(NULL)
  }
  
  gene <- dat[gene_name == "TPI1"]
  
  if (nrow(gene) == 0) {
    warning("NME2 not found: ", f)
    return(NULL)
  }
  
  data.frame(
    file_id = sample_primary$File.ID[i],
    file_name = sample_primary$File.Name[i],
    patient = sample_primary$Case.ID[i],
    project = sample_primary$Project.ID[i],
    sample_id = sample_primary$Sample.ID[i],
    NME2_TPM = as.numeric(gene$tpm_unstranded[1])
  )
})

nme2_expr <- bind_rows(nme2_list)

