##生存分析
plot_km <- function(dat, cohort_name) {
  
  cutoff <- mean(
    dat$NME2_log2,
    na.rm = TRUE
  )
  
  dat <- dat %>%
    mutate(
      NME2_group = ifelse(
        NME2_log2 >= cutoff,
        "High",
        "Low"
      )
    )
  
  dat$NME2_group <- factor(
    dat$NME2_group,
    levels = c("Low", "High")
  )
  
  fit <- survfit(
    Surv(OS_time, OS_event) ~ NME2_group,
    data = dat
  )
  
  p <- ggsurvplot(
    fit,
    data = dat,
    pval = TRUE,
    risk.table = TRUE,
    conf.int = TRUE,
    xlab = "Days",
    ylab = "Overall survival probability",
    title = cohort_name,
    linetype = "strata",  
    palette = "jco",    
    legend.title = "TPI1 expression",
    legend.labs = c("Low", "High")
  )
  
  return(p)
}

plot_km(surv_coad,"TCGA-COAD")
