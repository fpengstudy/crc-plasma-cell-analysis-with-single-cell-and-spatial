##单因素分析
run_cox <- function(dat, cohort_name) {
  
  # 单因素 Cox：NME2 连续变量
  fit_uni <- coxph(
    Surv(OS_time, OS_event) ~ NME2_z,
    data = dat
  )
  
  uni_result <- tidy(
    fit_uni,
    exponentiate = TRUE,
    conf.int = TRUE
  ) %>%
    mutate(
      Cohort = cohort_name,
      Model = "Univariable"
    )
  
  # 多因素 Cox：调整年龄、性别、分期
  dat_multi <- dat %>%
    filter(
      !is.na(demographic.age_at_index),
      !is.na(demographic.sex_at_birth),
      !is.na(diagnoses.ajcc_pathologic_stage)
    ) %>%
    mutate(
      demographic.sex_at_birth = factor(demographic.sex_at_birth),
      diagnoses.ajcc_pathologic_stage = factor(diagnoses.ajcc_pathologic_stage)
    ) %>%
    droplevels()
  
  fit_multi <- coxph(
    Surv(OS_time, OS_event) ~
      NME2_z + demographic.age_at_index + demographic.sex_at_birth + diagnoses.ajcc_pathologic_stage,
    data = dat_multi
  )
  
  multi_result <- tidy(
    fit_multi,
    exponentiate = TRUE,
    conf.int = TRUE
  ) %>%
    mutate(
      Cohort = cohort_name,
      Model = "Multivariable"
    )
  
  list(
    univariable = fit_uni,
    multivariable = fit_multi,
    uni_table = uni_result,
    multi_table = multi_result,
    multi_data = dat_multi
  )
}
