orig_score <- df[,c(12,14:ncol(df))]

four_stage_FDR <- c()
primary_vs_metastasis <- c()
primary_vs_colon <- c()
meta_vs_colon <- c()
##存在不符合正态分布数值，使用kruskal.test
for (i in 2:ncol(orig_score)){
  score_name <- colnames(orig_score)[i]
  #fit <- aov(orig_score[[score_name]]~orig_score$sample_orig)
  #FDR_value <- summary(fit)[[1]]["Pr(>F)"][1,]
  ## 使用kruskal.test的四个阶段差异显著的通路
  fit <- kruskal.test(orig_score[[score_name]]~orig_score$sample_orig, data=orig_score)
  p_value <- fit[[3]]
  four_stage_FDR <- c(four_stage_FDR,p_value)
  ## 使用pairwise.t.test对primary和metastasis差异显著的通路
  pairwise_value <- pairwise.t.test(orig_score[[score_name]],orig_score$sample_orig,p.adj = "bonf",data=orig_score)
  pairwise_value_p <- pairwise_value[[3]][3,3]
  primary_vs_metastasis <- c(primary_vs_metastasis,pairwise_value_p)

  parwise_value_privs_colon <- pairwise_value[[3]][3,1]
  primary_vs_colon <- c(primary_vs_colon,parwise_value_privs_colon)
  parwise_value_metavs_colon <- pairwise_value[[3]][2,2]
  meta_vs_colon <- c(meta_vs_colon,parwise_value_metavs_colon)
  
}
