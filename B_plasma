cols_to_add <- c("S.Score", "G2M.Score","Phase")
tff3_extended <- tff3_cells@meta.data
for(col in cols_to_add) {
  # 检查列是否存在于bcell@meta.data表中
  if(col %in% colnames(bcell@meta.data)) {
    tff3_extended[[col]] <- NA  # 先初始化为NA
    # 只为有对应行名的行赋值
    common_rows <- intersect(rownames(tff3_extended), rownames(bcell@meta.data))
    tff3_extended[common_rows, col] <- bcell@meta.data[common_rows, col]
  } else {
    warning(paste("列", col, "在A表中不存在"))
  }
}



